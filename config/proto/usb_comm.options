type {
    .*_cb_payload {
        type = FT_CALLBACK
    }
}

// 确保特殊字段使用回调
field {
    .*\.zephyr_version {
        type = FT_CALLBACK
    }
}

field {
    .*\.zmk_version {
        type = FT_CALLBACK
    }
}

field {
    .*\.app_version {
        type = FT_CALLBACK
    }
}

field {
    .*\.bits {
        type = FT_CALLBACK
    }
}

field {
    .*\.layer_name {
        type = FT_CALLBACK
    }

    .*\.prefs {
        type = FT_CALLBACK
    }
}